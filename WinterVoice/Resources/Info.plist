<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleDisplayName</key>
    <string>WinterVoice</string>
    <key>LSUIElement</key>
    <false/>
    <key>NSMicrophoneUsageDescription</key>
    <string>WinterVoice captures audio while you hold the push-to-talk key for the transcription provider you configure.</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <!-- Permits the documented explicit HTTP option for localhost/LAN
             endpoints only; app-level validation requires the host to be a
             loopback, RFC1918, or .local literal before accepting http. -->
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
</dict>
</plist>
